app-misc/brightnessctl udev
# Waybar tray is already used in the DWL tier (also shared by LocalSend later).
dev-libs/libdbusmenu gtk3
gui-apps/wf-recorder pipewire
gui-apps/swaylock-effects pam -gdk-pixbuf -man
# Backlight display uses udev; scrolling uses brightnessctl, not login-proxy.
