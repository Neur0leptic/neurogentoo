From 063657b989f8ca45767a225212702631e3ea9f97 Mon Sep 17 00:00:00 2001
From: syntheticsweet <dev@syntheticsweet.org>
Date: Tue, 8 Sep 2026 16:07:26 +0000
Subject: [PATCH] fix giomm/meson.build to accomodate building with samurai

---
 gio/giomm/meson.build | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/gio/giomm/meson.build b/gio/giomm/meson.build
index 6a08d39f..c2b2bda2 100644
--- a/gio/giomm/meson.build
+++ b/gio/giomm/meson.build
@@ -292,9 +292,12 @@ if maintainer_mode
   # If giomm_used_built_h_file_targets would be listed as sources to giomm_library,
   # all generated .cc files could be recompiled if one generated .h file has
   # been changed.
-  built_dummy_h_file_target = custom_target('giomm-dummy_header.h',
+  #
+  # Use a different target than the one generated by glibmm so that all generated
+  # headers for both libraries are able to be listed as source here.
+  giomm_built_dummy_h_file_target = custom_target('giomm-dummy_header.h',
     input: giomm_built_h_file_targets,
-    output: 'dummy_header.h',
+    output: 'giomm_dummy_header.h',
     command: [
       python3, dummy_header_py,
       '@OUTPUT@',
@@ -305,8 +308,8 @@ if maintainer_mode
 
   extra_include_dirs = ['..', '..' / '..' / 'glib']
 
-  giomm_library = library(giomm_libname, extra_giomm_objects,
-    giomm_used_built_cc_file_targets, giomm_extra_cc_files, built_dummy_h_file_target,
+  giomm_library = library(giomm_libname, extra_giomm_objects, built_dummy_h_file_target,
+    giomm_used_built_cc_file_targets, giomm_extra_cc_files, giomm_built_dummy_h_file_target,
     version: glibmm_libversion,
     darwin_versions: macos_darwin_versions,
     implicit_include_directories: false,
-- 
