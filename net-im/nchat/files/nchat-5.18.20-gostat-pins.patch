Use the checked-in union of both upstream Go module requirements. All Go access
still goes through go-module.eclass's file:// proxy of declared distfiles.

--- a/lib/gostat/assemble.sh
+++ b/lib/gostat/assemble.sh
@@ -68,14 +68,8 @@
-# Seed go.mod with only the two replace directives; -mod=mod derives the full
-# (unioned) dependency graph from the two vendored modules automatically, so
-# this needs no hand-maintained require list that could drift on a dep bump.
-cat > "$STAGE/go.mod" <<EOF
-module $MODULE
-
-go 1.25.0
-
-replace go.mau.fi/whatsmeow => $WM_DIR/ext/whatsmeow
-replace go.mau.fi/mautrix-signal => $SG_DIR/ext/signal
-EOF
+# The packager verifies this union against the two pinned upstream go.mod
+# files. -mod=mod may complete the generated graph from the local proxy, but
+# direct dependencies must not be discovered through an unpinned latest query.
+sed -e "s|@WM_DIR@|$WM_DIR|g" -e "s|@SG_DIR@|$SG_DIR|g" \
+  "$(dirname "$0")/go.mod" > "$STAGE/go.mod"
 
 # Union of the two go.sum files (both pin identical shared-dep versions, so a
 # plain dedup is safe); -mod=mod fills any remaining entries.
